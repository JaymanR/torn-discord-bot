<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>30f83fac-8946-4f1f-9b68-3cdb683e4525</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
        <PackageReference Include="NetCord" Version="1.0.0-beta.30" />
        <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.30" />
        <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.30" />
        <PackageReference Include="NetCord.Services" Version="1.0.0-beta.30" />
    </ItemGroup>

</Project>
